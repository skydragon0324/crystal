# ---------------------------------------------------------------------------
# Crystal backend environment. Copy to `.env` and adjust per machine.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5100
API_PREFIX=/api

# Public base url of this server, used to build absolute urls for uploads.
#
# BEHIND NGINX this is the browser-facing origin, not the port node listens
# on - the frontends are served from the same origin and reach the API at
# /api, so an absolute URL naming :5100 points at a port nobody outside the
# machine can open. See deploy/nginx.conf.
#
#   PUBLIC_URL=https://crystal.example
#
# CORS_ORIGINS can then be left empty: same-origin requests need no CORS
# header, and listing an origin that never appears grants nothing.
PUBLIC_URL=http://localhost:5100

# Allowed CORS origins, comma separated (crystal-web, crystal-admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- PostgreSQL (primary store) --------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=vendor
PG_PASSWORD=qwer1234
PG_DATABASE=vendor
# Crystal lives in its own schema so it can share a database with other projects.
PG_SCHEMA=crystal_v1
PG_POOL_MIN=2
PG_POOL_MAX=10

# --- Oracle (secondary, legacy serial-number lookup only) ------------------
# Leave ORACLE_ENABLED=false when no oracle instance is reachable. Serial
# number lookups then fall back to the local `oracle_serials` mirror table.
ORACLE_ENABLED=false
ORACLE_USER=crystal
ORACLE_PASSWORD=crystal
ORACLE_CONNECT_STRING=127.0.0.1:1521/XEPDB1
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=4
ORACLE_LIB_DIR=

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-crystal-user-secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change-me-crystal-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=change-me-crystal-admin-secret
ADMIN_JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- OTP (mobile login) -----------------------------------------------------
# In development the generated code is echoed back in the API response so the
# mobile login flow can be exercised without an SMS gateway.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_ECHO_IN_RESPONSE=true

# --- Certificate sign-in (desktop Sign in button) -------------------------
# The vendor's X.509 flow: a certificate agent on the member's PC
# (127.0.0.1:20206) signs a challenge from POST /api/auth/x509/primary_data,
# and POST /api/auth/x509/x509_login checks the certificate against the CA
# chain and the personal policies and signs in the user ID in its CN.
#
# OFF until every file below is provided. Off, a desktop's Sign in button goes
# to the password page at /auth/reganam, as the vendor does in development.
#
# To try it locally without the real CA or the agent:
#   node scripts/x509-dev-pki.js      (prints the lines to put here)
X509_LOGIN=false
X509_SERVER_KEY=
X509_SERVER_CERT_URL=
X509_CA_RSA_CHAIN=
X509_CA_ECC_CHAIN=
# X509_POLICY_IDS=1.2.408.20020827.8.3.3,1.2.408.20020827.8.3.2.1,1.2.408.20020827.8.3.2.2,1.2.408.20020827.8.3.2.3
# X509_MIN_CLIENT_VERSION=1214

# --- Signed content --------------------------------------------------------
# Notices, FAQs and uploaded images are signed, and the storefront renders
# them only once the signature verifies. See docs/content-signing.md.
# Repeated verification is cached by exact payload/signature. Verified image
# buffers use a bounded in-memory LRU; every request still checks file identity
# and the current signature row before reuse. Set either value to 0 to disable.
CONTENT_VERIFICATION_CACHE_ENTRIES=5000
VERIFIED_IMAGE_CACHE_MB=64
#
# DEVELOPMENT: leave every CONTENT_SIGNING_* variable empty and run
# `npm run content-keys` once. That writes an ECDSA key and certificate to
# .content-keys/ (git- and svn-ignored) and the storefront's trusted key to
# crystal-web/.env.development.local.
#
# PRODUCTION: the algorithm, the key id and a key source are required, and
# anything invalid stops the server at startup - there is no fallback
# algorithm and no fallback key.
#
#   ECDSA (the default choice)            RSA-PSS
#   CONTENT_SIGNING_ALGORITHM=ECDSA         CONTENT_SIGNING_ALGORITHM=RSA
#   CONTENT_SIGNING_KEY_ID=content-key-v1   CONTENT_SIGNING_KEY_ID=content-key-rsa-v1
#
# The ALGORITHM and the KEY ID are always required, and the active key comes
# from ONE of two places:
#
#   a .p12 from your CA (CONTENT_SIGNING_P12 below), or
#   a key directory (CONTENT_SIGNING_KEY_DIR) holding <keyId>.key.pem (the
#   active key only, mode 600) and <keyId>.crt.pem for every key id named here.
#
# Keep either outside the checkout. The key id is the name the storefront pins
# the public key under; it is never read out of the certificate. The algorithm
# must match the key's type (ECDSA: an EC P-256 key; RSA: RSA of 3072 bits or
# more) or the server refuses to start.
CONTENT_SIGNING_ALGORITHM=
CONTENT_SIGNING_KEY_ID=
CONTENT_SIGNING_KEY_DIR=
#
# PKCS#12. When CONTENT_SIGNING_P12 is set, the ACTIVE key is the private key
# in that file and its certificate is the one issued for it; the key directory
# above is then only where PREVIOUS keys' certificates are read from (needed
# only when CONTENT_SIGNING_VERIFY_KEY_IDS names any).
#
# The password is required with the file. It reaches openssl through the
# child process's environment, never its command line, and is never logged or
# written anywhere. What it protects: the .p12 wherever it is copied - backups,
# transfers, a mistaken commit. What it does NOT protect: this server. Anyone
# who can read this .env can read the password beside the path.
#
# The CA chain (the root, and any intermediates, as PEM) is what the
# certificate must verify against, together with any CA certificates bundled
# in the .p12. REQUIRED in production whenever a .p12 is used; optional in
# development (startup then says the chain was not checked). With a key
# directory it is optional everywhere, and applies the same checks when set.
# The storefront does not use the chain: it still pins one public key, printed
# after the same checks by
#   CONTENT_SIGNING_P12_PASSWORD=... npm run content-keys -- --from-p12 <file> --ca-chain <file> --key-id <id>
# For a development .p12 and CA to try this with: npm run content-keys -- --dev-p12
#
#   CONTENT_SIGNING_ALGORITHM=ECDSA
#   CONTENT_SIGNING_KEY_ID=content-key-v2
#   CONTENT_SIGNING_P12=/secure/content-signing.p12
#   CONTENT_SIGNING_P12_PASSWORD=the-export-password
#   CONTENT_SIGNING_CA_CHAIN=/secure/caChain.crt
CONTENT_SIGNING_P12=
CONTENT_SIGNING_P12_PASSWORD=
CONTENT_SIGNING_CA_CHAIN=
#
# Previous key ids still believed while their content is re-signed (rotation,
# renewal). Their certificates are <keyId>.crt.pem in CONTENT_SIGNING_KEY_DIR.
CONTENT_SIGNING_VERIFY_KEY_IDS=
# Key ids never believed, even if listed above.
CONTENT_SIGNING_REVOKED_KEY_IDS=
# openssl reads the certificates, checks the chain and opens the .p12 (Node 12
# cannot). OpenSSL 3 opens an old RC2/RC4-encrypted .p12 only with its legacy
# provider - re-export such a file (docs/content-signing.md).
# OPENSSL_BIN=openssl

# --- Storage ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# --- Business rules ---------------------------------------------------------
POINTS_PRODUCT_REGISTER=500
POINTS_DAILY_LOGIN=10
POINTS_PURCHASE_PER_UNIT=1
LICENSE_POINTS_COST=1000

# --- The legacy database: feedback and the blog ----------------------------
# Those two domains live in the vendor's Oracle instance and are read and
# written there. See src/config/legacy.js.
#
#   postgres  development. sql/legacy/ creates ora_pid and ora_blog as schemas
#             in the PostgreSQL database above; `npm run legacy:install` fills
#             them. Same server, same credentials, separate pool.
#   oracle    deployment. Set the three LEGACY_ORACLE_* values below.
#
# The query code is identical either way - every table is addressed
# schema-qualified, so `ora_pid.feedback_threads` is correct on both.
LEGACY_DRIVER=postgres
LEGACY_PID_SCHEMA=ora_pid
LEGACY_BLOG_SCHEMA=ora_blog
LEGACY_POOL_MIN=1
LEGACY_POOL_MAX=8

# Used only when LEGACY_DRIVER=oracle. They default to the ORACLE_* values
# above, so a deployment where the warehouse and the legacy tables are the
# same instance needs only LEGACY_DRIVER=oracle.
#LEGACY_ORACLE_USER=
#LEGACY_ORACLE_PASSWORD=
#LEGACY_ORACLE_CONNECT_STRING=
#LEGACY_ORACLE_LIB_DIR=

# --- The Eshop and Appstore services ---------------------------------------
# Orders, purchases, comments, favourites and both wallets are HTTP calls to
# five separate systems, not tables. See src/config/remote.js.
#
# REMOTE_MOCK=true answers them in-process with responses in each service's own
# wire format, so the mapping code runs exactly as it will in production. Turn
# it off and set the five URLs to go live; /health reports 'mock' until you do.
REMOTE_MOCK=true
REMOTE_TIMEOUT_MS=15000
ESHOP_SERVER_URL=
ESHOP_WALLET_URL=
# The Eshop wallet only answers callers whose Referer it trusts; the vendor
# sends this on every wallet call.
ESHOP_WALLET_REFERER=
APPSTORE_SERVER_URL=
APPSTORE_WALLET_URL=
# The eproduct site: registrations, and the Karaoke/Manbang/B-media keygen logs.
WEB_SERVER_URL=

# ---------------------------------------------------------------------------
# Language
# ---------------------------------------------------------------------------
# What a caller with NO preference is answered in. 'en', 'zh' or 'ru'.
#
# This is not a way to force a language on anybody: X-Lang (which both
# frontends send) and then Accept-Language are consulted first, and a browser
# sends at least one of them. What this decides is the reply to a webhook, a
# health check, a curl - anything with no opinion.
#
# An unrecognised value falls back to 'en' rather than failing to start.
DEFAULT_LOCALE=en
