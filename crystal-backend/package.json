{
  "name": "crystal-backend",
  "version": "1.0.0",
  "description": "Crystal platform API - catalogue, member centre and after-sales service operations",
  "main": "app.js",
  "scripts": {
    "start": "nodemon app.js",
    "serve": "node app.js",
    "migrate": "node scripts/ensure-schema.js && knex --knexfile src/db/knexfile.js migrate:latest",
    "rollback": "knex --knexfile src/db/knexfile.js migrate:rollback",
    "rollback:all": "knex --knexfile src/db/knexfile.js migrate:rollback --all",
    "seed": "node scripts/ensure-schema.js && knex --knexfile src/db/knexfile.js seed:run",
    "db:reset": "npm run content-keys && node scripts/reset-schema.js && npm run migrate && npm run seed && npm run mock:images && npm run legacy:install && npm run sign:backfill",
    "schema:export": "node scripts/export-schema.js",
    "build": "node scripts/build.js",
    "build:min": "node scripts/build.js --min",
    "mock:images": "node scripts/generate-mock-images.js",
    "check": "node scripts/check.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "schema:verify": "node scripts/verify-schema.js",
    "migrate:verify": "node scripts/verify-migrations.js",
    "pages:sync": "node scripts/sync-pages.js",
    "legacy:install": "node scripts/install-legacy.js",
    "demo:account": "node scripts/demo-account.js",
    "content-keys": "node scripts/content-keys.js",
    "sign:audit": "node scripts/sign-audit.js",
    "sign:backfill": "node scripts/sign-backfill.js",
    "test:signing": "node test/signing.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "3.1.1",
    "axios": "0.21.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "1.20.3",
    "compression": "1.7.4",
    "connect-busboy": "0.0.2",
    "cookie-parser": "1.4.5",
    "core-js": "3.40.0",
    "cors": "2.8.5",
    "crc": "3.8.0",
    "cron": "1.8.2",
    "cross-env": "7.0.3",
    "crypto-js": "3.3.0",
    "dotenv": "8.2.0",
    "exceljs": "4.2.0",
    "express": "4.21.2",
    "express-promise-router": "4.1.1",
    "express-validator": "6.14.0",
    "fast-json-stable-stringify": "2.1.0",
    "form-data": "3.0.1",
    "formidable": "2.1.2",
    "helmet": "4.6.0",
    "ioredis": "5.11.1",
    "jju": "1.3.0",
    "jpeg-js": "0.4.4",
    "js2xmlparser": "4.0.2",
    "jsonwebtoken": "8.5.1",
    "knex": "0.21.20",
    "lodash": "4.17.21",
    "md5": "2.3.0",
    "moment": "2.29.1",
    "mongoose": "5.13",
    "multer": "1.4.2",
    "mysql2": "2.3.3",
    "nedb": "1.8.0",
    "node-forge": "0.10.0",
    "oracledb": "4.2.0",
    "pdfjs-dist": "2.16.105",
    "pdfkit": "^0.13.0",
    "pg": "8.7.3",
    "pngjs": "3.4.0",
    "qs": "6.14.0",
    "redis": "3.1.2",
    "regenerator-runtime": "0.13.11",
    "sanitize-html": "2.14.0",
    "shelljs": "0.8.5",
    "sshpk": "1.16.1",
    "striptags": "3.2.0",
    "unzipper": "0.10.14",
    "xlsx": "0.16.9",
    "xml2js": "0.4.23",
    "zip-dir": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.14.6",
    "@babel/preset-env": "7.14.7",
    "@babel/preset-react": "7.14.5",
    "babel-loader": "8.2.2",
    "nodemon": "2.0.7",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12",
    "webpack-node-externals": "1.7.2"
  },
  "engines": {
    "node": ">=12.22"
  }
}
