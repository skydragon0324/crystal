REACT_APP_API_URL=http://localhost:5100/api
PORT=3001
BROWSER=none
SKIP_PREFLIGHT_CHECK=true

# --- Deploying under a URL prefix (nginx) -----------------------------------
# Behind nginx this console is served from a sub-path rather than from the
# root. Both of these are read at BUILD time, not at runtime.
#
#   PUBLIC_URL          where the assets live AND what <BrowserRouter basename>
#                       is taken from (see src/App.js). Set them from one
#                       variable so the two cannot disagree.
#   REACT_APP_API_URL   a PATH, not a host - the browser then calls the origin
#                       it loaded from, so there is no CORS and nothing to
#                       change when the hostname does. /uploads is derived
#                       from it by stripping /api.
#
# See deploy/nginx.conf for the server block these two match.
#PUBLIC_URL=/crystal_admin
#REACT_APP_API_URL=/api

# The language to start in, before the visitor has chosen one. 'en' or 'zh'.
#
# BAKED IN AT BUILD TIME, like every REACT_APP_ variable - changing it means
# rebuilding, not restarting.
#
# A choice made with the switcher is kept in that browser's localStorage and
# always wins, so this only moves people arriving for the first time.
REACT_APP_DEFAULT_LOCALE=en
