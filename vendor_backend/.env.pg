# --- PostgreSQL ---------------------------------------------
# Replaces the Oracle DB_CONNECT_STRING, which has no pg equivalent.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vendor
DB_USER=vendor_app
DB_PASSWORD=change_me

# Schema the app reads/writes. The converted DDL is unqualified, so it
# lands in whatever this points at.
DB_SCHEMA=public

# Set to true only if your server requires TLS.
DB_SSL=false

# Was 600 under Oracle. Postgres forks a backend process per connection
# and ships with max_connections=100, so keep this well under that,
# divided by the number of app instances you run.
DB_POOL_MAX=20
